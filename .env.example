# Optional. Without a key, Helm shows the bundled analysis for each checkpoint.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pick a model explicitly as provider:model-id. Defaults to openai:gpt-4.1, then anthropic:claude-sonnet-4-5.
HELM_MODEL=

# Set to 1 to save live re-runs from the UI to data/checkpoints/<id>.json.
HELM_WRITE_CACHE=
